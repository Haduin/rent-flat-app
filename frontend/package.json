{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean-api": "node -e \"for (const p of ['apis', 'models', 'dist', '.openapi-generator', 'index.ts', 'runtime.ts', '../../../node_modules/.tmp/tsconfig.generated.tsbuildinfo']) require('fs').rmSync('src/api/generated/' + p, {recursive: true, force: true})\"",
    "generate-api": "pnpm clean-api && openapi-generator-cli generate -i http://localhost:8080/openapi.json -g typescript-fetch -o src/api/generated "
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-table": "^8.21.3",
    "formik": "^2.4.9",
    "oidc-spa": "10.2.18",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.14.0",
    "vite": "^8.0.7",
    "yup": "^1.7.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@openapitools/openapi-generator-cli": "^2.31.0",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.58.0",
    "web-vitals": "^4.2.4"
  }
}
